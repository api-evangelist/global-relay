                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"<uuid>\",\n  \"email\": {\n    \"from\": {\n      \"address\": \"<email>\",\n      \"displayName\": \"<string>\"\n    },\n    \"to\": [\n      {\n        \"address\": \"<email>\",\n        \"displayName\": \"<string>\"\n      },\n      {\n        \"address\": \"<email>\",\n        \"displayName\": \"<string>\"\n      }\n    ],\n    \"subject\": \"<string>\",\n    \"sentDate\": \"<dateTime>\",\n    \"messageId\": \"<string>\",\n    \"cc\": [\n      {\n        \"address\": \"<email>\",\n        \"displayName\": \"<string>\"\n      },\n      {\n        \"address\": \"<email>\",\n        \"displayName\": \"<string>\"\n      }\n    ],\n    \"bcc\": [\n      {\n        \"address\": \"<email>\",\n        \"displayName\": \"<string>\"\n      },\n      {\n        \"address\": \"<email>\",\n        \"displayName\": \"<string>\"\n      }\n    ],\n    \"receivedDate\": \"<dateTime>\",\n    \"body\": {\n      \"contentType\": \"<string>\",\n      \"content\": \"<string>\"\n    },\n    \"headers\": [\n      {\n        \"name\": \"<string>\",\n        \"value\": \"<string>\"\n      },\n      {\n        \"name\": \"<string>\",\n        \"value\": \"<string>\"\n      }\n    ],\n    \"attachmentIds\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  }\n}",
