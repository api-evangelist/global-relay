          "request": {
            "name": "Global Relay Archive an email",
            "description": {
              "content": "Archives an email message to the Global Relay Archive. Each request must include a unique requestId (UUID). Emails can include headers, body content, recipients, and references to file attachments uploaded via the /files endpoint. Rate limited to 1000 requests per minute.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "email"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
