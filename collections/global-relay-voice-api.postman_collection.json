                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"<uuid>\",\n  \"voiceRecord\": {\n    \"callId\": \"<string>\",\n    \"callType\": \"<string>\",\n    \"startTime\": \"<dateTime>\",\n    \"endTime\": \"<dateTime>\",\n    \"participants\": [\n      {\n        \"participantId\": \"<string>\",\n        \"displayName\": \"<string>\",\n        \"email\": \"<email>\",\n        \"role\": \"<string>\"\n      },\n      {\n        \"participantId\": \"<string>\",\n        \"displayName\": \"<string>\",\n        \"email\": \"<email>\",\n        \"role\": \"<string>\"\n      }\n    ],\n    \"title\": \"<string>\",\n    \"duration\": \"<integer>\",\n    \"fileIds\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"transcript\": \"<string>\"\n  }\n}",
